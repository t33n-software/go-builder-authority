{
  "schemaVersion": 3,
  "toolchain": { "goVersion": "1.26.6" },
  "defaults": {
    "includeFamilies": [
      "feature",
      "fix",
      "docs",
      "refactor",
      "chore",
      "test",
      "perf",
      "hotfix"
    ]
  },
  "gates": [
    {
      "name": "go-builder-authority-source-quality",
      "command": "go",
      "args": [
        "run",
        "-mod=readonly",
        "./cmd/build"
      ],
      "timeout": "15m"
    }
  ],
  "project": {
    "binaries": [
      {
        "package": "./cmd/build",
        "smoke": ["--version"]
      },
      {
        "package": "./cmd/check-coverage",
        "smoke": ["--version"]
      }
    ]
  }
}
